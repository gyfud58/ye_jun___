import urllib.request
from bs4 import BeautifulSoup

# 크롤링할 뉴스 URL
url = "https://www.dailian.co.kr/news/view/1519563/?sc=Naver"

# URL 요청
response = urllib.request.urlopen(url)
html = response.read().decode('utf-8')

# BeautifulSoup으로 파싱
soup = BeautifulSoup(html, 'html.parser')

# 제목 가져오기
title_tag = soup.find('title')
title = title_tag.get_text().strip() if title_tag else "제목 없음"

# 본문 가져오기
# dailian.co.kr은 보통 기사 내용을 아래 클래스에 담음 (크롬 개발자도구로 class 확인 필요)
# 실제 클래스명이 다를 수 있으니 크롬 F12로 꼭 확인하세요
content_tag = soup.find('div', class_='view-content')

if content_tag:
    content_text = content_tag.get_text(separator='\n').strip()
else:
    content_text = "본문을 찾을 수 없습니다."

print("뉴스 제목:", title)
print("뉴스 본문:", content_text)
